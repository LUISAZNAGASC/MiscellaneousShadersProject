TITLE:

Analytic_Checkerboard_01

TAGS:

procedural, checkerboard, antialiasing, utility

DESCRIPTION:

Screen-space procedural checkerboard rendered with analytic anti-aliasing using fwidth(). Includes configurable tile colors, optional grid lines, and proper sRGB output.

CODE:

void applyCheckerboardBackground(inout vec3 fragmentColor, const in vec2 pixelCoordinates, const in vec3 squareColor01, const in vec3 squareColor02, const in float squareDimension, const in vec3 segmentColor, const in float segmentDimension)
{
    if (squareDimension <= 0.0) return;
    
    vec2 squarePosition = pixelCoordinates / squareDimension;
    
    vec2 squareFootprint = max(vec2(1e-7), fwidth(squarePosition));
    
    vec2 negativeCorner = abs(fract(0.5 * (squarePosition - 0.5 * squareFootprint)) - 0.5);
    vec2 positiveCorner = abs(fract(0.5 * (squarePosition + 0.5 * squareFootprint)) - 0.5);
    
    float squareSelection = 2.0 * (negativeCorner.x - positiveCorner.x) * (negativeCorner.y - positiveCorner.y);
    squareSelection = 0.5 - squareSelection / (squareFootprint.x * squareFootprint.y);
    
    fragmentColor = mix(squareColor01, squareColor02, squareSelection);
    
    if (segmentDimension <= 0.0) return;
    
    vec2 segmentPosition = mod(pixelCoordinates, squareDimension);
    segmentPosition = min(segmentPosition, squareDimension - segmentPosition);
    
    float segmentDistance = min(segmentPosition.x, segmentPosition.y);
    
    vec2 segmentThreshold = segmentDimension + vec2(-0.5, 0.5) * fwidth(segmentDistance);
    
    float segmentSelection = smoothstep(segmentThreshold.x, segmentThreshold.y, segmentDistance);
    
    fragmentColor = mix(segmentColor, fragmentColor, segmentSelection);
}

void applyGammaCorrection(inout vec3 fragmentColor)
{
    fragmentColor = max(vec3(0.0), fragmentColor);
    
    vec3 lowerSelection = 12.92 * fragmentColor;
    
    vec3 upperSelection = 1.055 * pow(fragmentColor, vec3(0.4166667)) - 0.055;
    
    vec3 pickerSelection = step(0.0031308, fragmentColor);
    
    fragmentColor = mix(lowerSelection, upperSelection, pickerSelection);
}

void mainImage(out vec4 fragmentColor, in vec2 fragmentPosition)
{
    fragmentColor = vec4(0.0, 0.0, 0.0, 1.0);
    
    vec2 pixelCoordinates = (2.0 * fragmentPosition - iResolution.xy) / min(iResolution.x, iResolution.y);
    
    applyCheckerboardBackground(fragmentColor.rgb, pixelCoordinates, vec3(0.15), vec3(0.05), 0.35, vec3(0.01), 0.01);
    
    applyGammaCorrection(fragmentColor.rgb);
}


