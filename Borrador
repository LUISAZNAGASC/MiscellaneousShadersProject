float getCurveCoverage(const in vec2 pixelCoordinates, const in float curveEvaluation, const in float curveDerivative, const in float lineThickness)
{
    float curveDistance = abs(pixelCoordinates.y - curveEvaluation);
    curveDistance = curveDistance / sqrt(1.0 + curveDerivative * curveDerivative);
    
    vec2 curveFootprint = lineThickness + vec2(-0.5, 0.5) * fwidth(curveDistance);
    
    float curveCoverage = 1.0 - smoothstep(curveFootprint.x, curveFootprint.y, curveDistance);
    
    return curveCoverage;
}

