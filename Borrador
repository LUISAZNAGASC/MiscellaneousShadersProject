    float curveCoverage05 = getCurveCoverage(pixelCoordinates, curveEvaluation05, curveDerivative05, lineThickness);
    vec3 curveColor05 = vec3(0.0, 1.0, 0.0);
    
    float curveEvaluation06 = 0.75 * cos(3.1415926 * pixelCoordinates.x + iTime);
    float curveDerivative06 = -0.75 * 3.1415926 * sin(3.1415926 * pixelCoordinates.x + iTime);
